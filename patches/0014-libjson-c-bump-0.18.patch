--- a/trunk/libs/libjson-c/Makefile
+++ b/trunk/libs/libjson-c/Makefile
@@ -1,13 +1,15 @@
-SRC_NAME=json-c-json-c-0.13.1-20180305
-SRC_URL=https://github.com/json-c/json-c/archive/json-c-0.13.1-20180305.tar.gz
-ARCHIVE_NAME=json-c-0.13.1-20180305
+SRC_NAME=json-c-json-c-0.18-20240915
+SRC_URL=https://github.com/json-c/json-c/archive/json-c-0.18-20240915.tar.gz
+# R-01 fix: 0.18 起 json-c 改为 CMake-only（无 autogen.sh / configure.ac / Makefile.am），
+#   且 ARCHIVE_NAME 原先与 SRC_NAME 分离，未同步会让 extract 去解旧包。现统一用 SRC_NAME。
+ARCHIVE_NAME=$(SRC_NAME)
 
 all: download_test extract_test config_test
-	$(MAKE) -j$(HOST_NCPU) -C $(SRC_NAME)
+	$(MAKE) -j$(HOST_NCPU) -C $(SRC_NAME)/build
 
 download_test:
 	( if [ ! -f $(ARCHIVE_NAME).tar.gz ]; then \
-		wget -t5 --timeout=20 --no-check-certificate $(SRC_URL); \
+		wget -t5 --timeout=20 --no-check-certificate -O $(ARCHIVE_NAME).tar.gz $(SRC_URL); \
 	fi )
 
 extract_test:
@@ -22,26 +24,27 @@
 		make configure && touch config_done; \
 	fi )
 
+# R-01 fix: json-c 官方提供 cmake-configure 兼容层（模拟原 autoconf 的
+#   --prefix / --enable-static / --enable-shared），须在独立 build 目录里跑。
 configure:
-	( cd $(SRC_NAME) ; \
-	sh autogen.sh; \
-	sed -e 's/#undef malloc.*//g' -e 's/#undef realloc.*//g' -i config.h.in; \
-	./configure \
+	( mkdir -p $(SRC_NAME)/build && cd $(SRC_NAME)/build ; \
+	CC=$(CONFIG_CROSS_COMPILER_ROOT)/bin/mipsel-linux-uclibc-gcc \
+	../cmake-configure \
 		--prefix=$(STAGEDIR) \
 		--enable-static \
 		--enable-shared \
-		--host=$(HOST_TARGET) \
-		--build=$(HOST_BUILD) ; \
+		--disable-Bsymbolic \
+		--disable-werror ; \
 	)
 
 clean:
-	if [ -f $(SRC_NAME)/Makefile ] ; then \
-		$(MAKE) -C $(SRC_NAME) distclean ; \
+	if [ -d $(SRC_NAME)/build ] ; then \
+		$(MAKE) -C $(SRC_NAME)/build clean ; \
 	fi ; \
 	rm -f config_done
 
 install:
-	$(MAKE) -C $(SRC_NAME) install DESTDIR=""
+	$(MAKE) -C $(SRC_NAME)/build install DESTDIR=""
 
 romfs:
 	cp -fP $(DESTDIR)/lib/libjson-c.so* $(ROMFSDIR)/lib
