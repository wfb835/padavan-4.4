--- a/trunk/linux-4.4.x/drivers/net/ethernet/raeth/raether.c
+++ b/trunk/linux-4.4.x/drivers/net/ethernet/raeth/raether.c
@@ -2806,6 +2806,16 @@
 	case RAETH_ESW_INGRESS_RATE:
 		result = copy_from_user(&ratelimit, ifr->ifr_data,
 					sizeof(ratelimit));
+		/* R-221-1 fix: validate port BEFORE the MMIO offset math.
+		 * port 是用户可控 unsigned int 且原代码无上界 ⇒
+		 * 0x1800 + 0x100*port 可指向 switch MMIO 窗口之外
+		 * （sys_reg_read 受控越界读）。上界照抄同函数内
+		 * RAETH_ESW_REG_READ/WRITE 对 reg.off 的硬检查模式；
+		 * 6 = MT7621 GSW 物理口 P0–P4 + CPU P6，宽于实际口数防误杀。 */
+		if (ratelimit.port > 6) {
+			ret = -EINVAL;
+			break;
+		}
 		offset = 0x1800 + (0x100 * ratelimit.port);
 		value = sys_reg_read(RALINK_ETH_SW_BASE + offset);
 
@@ -2836,6 +2846,12 @@
 	case RAETH_ESW_EGRESS_RATE:
 		result = copy_from_user(&ratelimit, ifr->ifr_data,
 					sizeof(ratelimit));
+		/* R-221-1 fix: 同 INGRESS —— port 上界检查前移，
+		 * 防 mii_mgr_write(0x1f, offset, value) 的受控偏移越界写。 */
+		if (ratelimit.port > 6) {
+			ret = -EINVAL;
+			break;
+		}
 		offset = 0x1040 + (0x100 * ratelimit.port);
 		value = sys_reg_read(RALINK_ETH_SW_BASE + offset);
 
