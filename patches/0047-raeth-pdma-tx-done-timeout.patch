+/* Bounded wait for one TX descriptor to be handed back by the MAC.
+ * Called with page_lock held and IRQs disabled: the normal path is a
+ * single bit test; 2 ms is the failure-path ceiling (a 1500-byte frame
+ * takes ~12 us at 1 Gbps).
+ */
+#define EI_PDMA_TX_TIMEOUT_US	2000
+static inline int ei_pdma_tx_wait_done(struct END_DEVICE *ei_local,
+				       unsigned int idx)
+{
+	struct PDMA_txdesc *tx_ring = &ei_local->tx_ring0[idx];
+	unsigned int timeout = EI_PDMA_TX_TIMEOUT_US;
+
+	if (likely(tx_ring->txd_info2.DDONE_bit))
+		return 0;
+
+	do {
+		udelay(1);
+		barrier();
+		if (tx_ring->txd_info2.DDONE_bit)
+			return 0;
+	} while (--timeout);
+
+	return -ETIMEDOUT;
+}
