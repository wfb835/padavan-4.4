--- a/trunk/libs/libssl/Makefile
+++ b/trunk/libs/libssl/Makefile
@@ -1,5 +1,5 @@
-SRC_NAME=openssl-1.1.1k
-SRC_URL=https://www.openssl.org/source/$(SRC_NAME).tar.gz
+SRC_NAME=openssl-1.1.1w
+SRC_URL=https://github.com/openssl/openssl/releases/download/OpenSSL_1_1_1w/openssl-1.1.1w.tar.gz
 
 # openssl use CROSS_COMPILE prefix
 CC = gcc
@@ -39,8 +39,13 @@
 	fi )
 
 extract_test:
+	# R-02 fix: GitHub release tarball unpacks as openssl-OpenSSL_1_1_1w,
+	# which does not match SRC_NAME. Normalize the directory name.
 	( if [ ! -d $(SRC_NAME) ]; then \
 		tar -xf $(SRC_NAME).tar.gz; \
+		for d in openssl-OpenSSL_* ; do \
+			[ -d "$$d" ] && mv -f "$$d" $(SRC_NAME) ; \
+		done ; \
 		patch -d $(SRC_NAME) -p1 < $(SRC_NAME).patch; \
 	fi )
 
--- /dev/null
+++ b/trunk/libs/libssl/openssl-1.1.1w.patch
@@ -0,0 +1,93 @@
