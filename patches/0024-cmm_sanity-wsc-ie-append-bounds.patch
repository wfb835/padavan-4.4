+		if ((*LengthVIE + PeerWscIeLen + 6) >= MAX_VIE_LEN) {
+			MTWF_LOG(DBG_CAT_MLME, DBG_SUBCAT_ALL, DBG_LVL_WARN,
+					 ("%s() - WSC IE append skipped: %d + %d + 6 >= MAX_VIE_LEN\n",
+					  __func__, (int)*LengthVIE, (int)PeerWscIeLen));
+			goto SanityCheck;
+		}
+
 		Ptr = (PUCHAR) pVIE;
 		WscIe[1] = PeerWscIeLen + 4;
 		NdisMoveMemory(Ptr + *LengthVIE, WscIe, 6);
