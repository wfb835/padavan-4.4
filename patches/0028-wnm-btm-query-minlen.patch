--- a/trunk/linux-4.4.x/drivers/net/wireless/mediatek/mt7615/embedded/common/wnm.c
+++ b/trunk/linux-4.4.x/drivers/net/wireless/mediatek/mt7615/embedded/common/wnm.c
@@ -1434,6 +1434,18 @@
 		return;
 	}
 
+	/* F110-1: 本函数随后按 (UINT16)Elem->MsgLen - 24 - 3 算 BTMQueryLen，
+	 * 再按 BTMQueryLen + 1 字节拷贝，而 Buf 只按 Elem->MsgLen 分配。
+	 * MsgLen < 27 时该差值在 UINT16 下回绕到 65535 ⇒ 向 ~26 B 小堆块写
+	 * 65536 B。未认证单帧（category=10, action=6）即可触发，故在入口卡死
+	 * 最小帧长：802.11 头 24 + category 1 + action 1 + dialog token 1。 */
+	if (Elem->MsgLen < (ULONG)(sizeof(HEADER_802_11) + 3)) {
+		MTWF_LOG(DBG_CAT_PROTO, CATPROTO_WNM, DBG_LVL_ERROR,
+				 ("%s BTM Query frame too short (len=%lu), dropped\n",
+				  __func__, (unsigned long)Elem->MsgLen));
+		return;
+	}
+
 #ifdef CONFIG_11KV_API_SUPPORT
 	NetDev = pAd->ApCfg.MBSSID[APIndex].wdev.if_dev;
 #endif
