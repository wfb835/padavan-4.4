--- a/trunk/linux-4.4.x/drivers/net/wireless/mediatek/mt7615/embedded/security/owe.c
+++ b/trunk/linux-4.4.x/drivers/net/wireless/mediatek/mt7615/embedded/security/owe.c
@@ -519,14 +519,22 @@
 	BOOLEAN has_band_ch_info = FALSE;
 	UCHAR local_ssid_len = *(owe_vendor_ie + MAC_ADDR_LEN);
 	UCHAR ssid_field_len = sizeof(UCHAR);
-	UCHAR at_least_length = local_ssid_len + MAC_ADDR_LEN + ssid_field_len;
+	UINT16 at_least_length = local_ssid_len + MAC_ADDR_LEN + ssid_field_len;
 	UCHAR *pos = owe_vendor_ie;
 
 	/*Sanity check length information*/
-	if (owe_vendor_ie_len < (local_ssid_len + MAC_ADDR_LEN)) {
+	/* F85-2: local_ssid_len 直接取自 IE 第 6 字节，是 UCHAR（上界 255），
