+	 * IE 总长、不校验 SSID 长度 ⇒ 单帧即可向 pair_ssid 写 245 B（溢出 213 B）。
+	 * 另：band/ch 分支要连续读 2 B（band + ch），故下界取 at_least_length+2，
+	 * 原 `> at_least_length` 在 len==local+8 时会越界读 1 B。 */
+	if (local_ssid_len > MAX_LEN_OF_SSID) {
 		ret = FALSE;
 		goto end;
-	} else if (owe_vendor_ie_len > at_least_length)
+	} else if (owe_vendor_ie_len < (local_ssid_len + MAC_ADDR_LEN)) {
+		ret = FALSE;
+		goto end;
+	} else if (owe_vendor_ie_len >= (at_least_length + 2))
 		has_band_ch_info = TRUE;/*remain length */
 
 	NdisMoveMemory(pair_bssid, pos, MAC_ADDR_LEN);
